    <!-- Members Section -->
    <section id="members" class="py-20 md:py-32 bg-zinc-950 px-4 md:px-6">
        <div class="max-w-5xl mx-auto">
            <div class="text-center mb-12 md:mb-16">
                <h2 class="text-3xl md:text-5xl font-black mb-4 italic tracking-widest uppercase text-white">Database <span class="text-red-600">Prajurit</span></h2>
                <div class="h-1 w-20 md:w-24 bg-red-600 mx-auto mt-4"></div>
            </div>

            <div id="member-loader" class="flex justify-center items-center py-10">
                <div class="animate-spin rounded-full h-8 w-8 border-t-2 border-b-2 border-amber-500"></div>
            </div>

            <div class="glass-panel overflow-hidden shadow-2xl border border-white/5 hidden" id="member-table-container">
                <div class="overflow-x-auto">
                    <table class="w-full text-left member-table min-w-[600px]">
                        <thead class="bg-red-900/40 text-amber-500 uppercase text-[10px] md:text-xs font-black tracking-widest border-b border-red-600/30">
                            <tr>
                                <th class="px-4 md:px-6 py-4 text-center w-16">No.</th>
                                <th class="px-4 md:px-6 py-4">Nama Gubernur</th>
                                <th class="px-4 md:px-6 py-4 text-center">Jabatan</th>
