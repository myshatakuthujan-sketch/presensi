                        </thead>
                        <tbody id="member-list" class="text-xs md:text-sm text-gray-300">
                            <!-- Data injected here -->
                        </tbody>
                    </table>
                </div>
                <!-- Swipe indicator for mobile -->
                <div class="md:hidden p-3 bg-red-900/10 text-[9px] text-center text-gray-500 uppercase tracking-widest italic border-t border-white/5">
                    <i class="fas fa-arrows-alt-h mr-1"></i> Geser tabel ke samping untuk info lengkap
                </div>
            </div>
        </div>
    </section>

    <!-- Calendar Section -->
    <section id="events" class="py-20 md:py-32 px-4 md:px-6 bg-zinc-900/30">
        <div class="max-w-6xl mx-auto">
            <div class="text-center mb-12 md:mb-16">
                <h2 class="text-2xl md:text-4xl font-black mb-4 uppercase tracking-widest text-white">Kalender <span class="text-red-600">Event RoK</span></h2>
                <p class="text-[10px] md:text-xs text-gray-500 uppercase tracking-widest">Jadwal Global dari ROKHub.xyz</p>
                <div class="h-1 w-20 md:w-24 bg-red-600 mx-auto mt-4"></div>
            </div>

            <div class="calendar-wrapper shadow-2xl">
                <iframe 
                    src="https://rokhub.xyz/rok-events-calendar" 
                    class="w-full h-full border-none bg-white" 
                    title="ROK Events Calendar"
                    loading="lazy">
                </iframe>
            </div>

            <div class="mt-8 flex flex-col md:flex-row justify-between items-center gap-6 text-gray-500">
                <div class="flex items-center gap-2 text-[10px] uppercase tracking-widest text-center md:text-left">
