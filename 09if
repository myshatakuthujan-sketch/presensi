            <div class="flex flex-wrap justify-center gap-4">
                <a href="#announcements" class="w-full sm:w-auto px-8 py-4 bg-amber-600 hover:bg-amber-500 text-black font-black rounded-sm transition duration-300 transform hover:scale-105 shadow-xl uppercase tracking-widest text-sm">
                    PENGUMUMAN TERBARU
