<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>(09IF) Immortal Fighters - Kingdom #3909</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@400;700;900&family=Raleway:wght@300;400;600&display=swap');

        :root {
            --rok-gold: #fbbf24;
            --rok-red: #991b1b;
            --rok-bright-red: #ef4444;
            --rok-dark: #0f0a0a;
        }

        body {
            font-family: 'Raleway', sans-serif;
            background-color: var(--rok-dark);
            color: #e5e7eb;
            scroll-behavior: smooth;
        }

        h1, h2, h3, h4, .nav-brand {
            font-family: 'Cinzel', serif;
        }

        .hero-gradient {
            background: linear-gradient(rgba(10, 5, 5, 0.9), rgba(15, 10, 10, 0.95)), url('https://images.unsplash.com/photo-1518709268805-4e9042af9f23?auto=format&fit=crop&q=80&w=2000');
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
        }

        .glass-panel {
            background: rgba(153, 27, 27, 0.05);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(239, 68, 68, 0.2);
            border-radius: 1rem;
        }

        .logo-shield {
            background: linear-gradient(135deg, #991b1b, #ef4444);
            clip-path: polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%);
            border: 2px solid var(--rok-gold);
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 0 20px rgba(239, 68, 68, 0.5);
        }

        .logo-glow {
            filter: drop-shadow(0 0 15px rgba(239, 68, 68, 0.6));
            animation: pulse-glow 3s ease-in-out infinite;
        }

        @keyframes pulse-glow {
            0%, 100% { filter: drop-shadow(0 0 10px rgba(239, 68, 68, 0.4)); }
            50% { filter: drop-shadow(0 0 25px rgba(251, 191, 36, 0.6)); }
        }

        .animate-float {
            animation: float 4s ease-in-out infinite;
        }

        @keyframes float {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-15px); }
        }

        .red-gradient-text {
            background: linear-gradient(to bottom, #ffffff, #fbbf24);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: #0f0a0a; }
        ::-webkit-scrollbar-thumb { background: #991b1b; border-radius: 10px; }

        .member-table tr:nth-child(even) { background: rgba(255, 255, 255, 0.02); }
        .member-table tr:hover { background: rgba(153, 27, 27, 0.1); }
        
        .calendar-wrapper {
            position: relative;
            width: 100%;
            height: 600px;
            border-radius: 1rem;
            overflow: hidden;
            border: 1px solid rgba(251, 191, 36, 0.3);
        }

        @media (min-width: 768px) {
            .calendar-wrapper { height: 800px; }
        }

        .announcement-card {
            border-left: 4px solid var(--rok-bright-red);
            background: linear-gradient(90deg, rgba(153, 27, 27, 0.2) 0%, transparent 100%);
        }

        /* Mobile Nav Animation */
        #mobile-menu {
            transition: all 0.3s ease-in-out;
            transform: translateY(-100%);
            opacity: 0;
            pointer-events: none;
        }

        #mobile-menu.active {
            transform: translateY(0);
            opacity: 1;
            pointer-events: all;
        }
    </style>
</head>
<body class="overflow-x-hidden">

    <!-- Navigation -->
    <nav class="fixed w-full z-[100] bg-black/90 border-b border-red-600/30 px-4 md:px-8 py-4 flex justify-between items-center backdrop-blur-lg">
        <div class="flex items-center gap-3">
            <div class="logo-shield h-8 w-8 md:h-10 md:w-10 border border-amber-500/50">
                <span class="text-[8px] md:text-[10px] font-black text-white">09IF</span>
            </div>
            <span class="nav-brand text-lg md:text-xl font-bold text-white tracking-widest leading-none">
                <span class="text-amber-500">(09IF)</span> IMMORTAL
