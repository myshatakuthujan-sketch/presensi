    <!-- Mobile Menu Overlay -->
    <div id="mobile-menu" class="fixed inset-0 bg-black z-[90] flex flex-col items-center justify-center gap-8 lg:hidden">
        <a href="#home" onclick="toggleMenu()" class="text-xl font-bold text-white hover:text-amber-500 tracking-widest uppercase">Beranda</a>
        <a href="#announcements" onclick="toggleMenu()" class="text-xl font-bold text-white hover:text-amber-500 tracking-widest uppercase">Pengumuman</a>
        <a href="#members" onclick="toggleMenu()" class="text-xl font-bold text-white hover:text-amber-500 tracking-widest uppercase">Anggota</a>
        <a href="#events" onclick="toggleMenu()" class="text-xl font-bold text-white hover:text-amber-500 tracking-widest uppercase">Kalender</a>
        <a href="#join" onclick="toggleMenu()" class="px-8 py-3 bg-red-700 text-white rounded font-bold tracking-widest">GABUNG ALIANSI</a>
    </div>

    <!-- Hero Section -->
    <section id="home" class="relative min-h-screen flex items-center justify-center text-center px-6 hero-gradient">
        <div class="z-10 w-full max-w-4xl py-20">
            <div class="mb-8 md:mb-10 animate-float flex justify-center">
                <div class="logo-glow">
                    <div class="logo-shield w-28 h-28 md:w-40 md:h-40 border-4 border-amber-500 shadow-2xl relative">
                        <div class="flex flex-col items-center">
                            <span class="text-2xl md:text-4xl font-black text-white tracking-tighter">09IF</span>
                            <div class="h-0.5 w-8 md:w-12 bg-amber-500 my-1"></div>
                            <span class="text-[7px] md:text-[10px] font-bold text-amber-200 uppercase tracking-widest">Immortal</span>
                        </div>
                    </div>
                </div>
            </div>
            <h1 class="text-4xl sm:text-6xl md:text-8xl font-black mb-4 tracking-tighter text-white uppercase leading-tight">
                IMMORTAL <br class="sm:hidden"> <span class="red-gradient-text">FIGHTERS</span>
            </h1>
            <p class="text-base md:text-2xl lg:text-3xl text-red-500 font-bold mb-10 uppercase tracking-[0.2em] md:tracking-[0.4em] drop-shadow-md">
                Kingdom #3909 • Aliansi (09IF)
