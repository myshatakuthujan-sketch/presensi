    <!-- Announcement Section -->
    <section id="announcements" class="py-16 md:py-24 bg-black border-y border-red-900/30 px-6">
        <div class="max-w-4xl mx-auto">
            <div class="flex items-center gap-4 mb-10">
                <div class="w-10 h-10 md:w-12 md:h-12 rounded bg-red-600/20 flex items-center justify-center text-red-500 border border-red-600/40 shrink-0">
                    <i class="fas fa-bullhorn text-lg md:text-xl"></i>
                </div>
                <div>
                    <h2 class="text-xl md:text-2xl font-black uppercase tracking-widest text-white">Papan Pengumuman</h2>
                    <p class="text-[10px] md:text-xs text-gray-500 uppercase tracking-widest">Informasi Penting dari Pemimpin</p>
                </div>
            </div>

            <div id="ann-loader" class="py-10 text-center">
                <div class="animate-pulse text-gray-600 uppercase text-[10px] tracking-widest">Mengambil info pusat perintah...</div>
            </div>

            <div id="ann-container" class="space-y-4 hidden">
