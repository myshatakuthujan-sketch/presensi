    <!-- Footer -->
    <footer id="join" class="relative py-20 md:py-32 bg-black border-t border-red-600/20 px-6">
        <div class="max-w-2xl mx-auto text-center">
            <h2 class="text-3xl md:text-5xl font-black text-white mb-8 uppercase tracking-tighter">ANGKAT <span class="text-amber-500 text-shadow-glow">PEDANGMU</span></h2>
            <div class="flex flex-col sm:flex-row justify-center gap-4 mb-16">
                <a href="https://wa.me/905540040152" target="_blank" class="w-full sm:w-auto bg-emerald-700 hover:bg-emerald-600 text-white font-black py-4 px-10 rounded uppercase tracking-widest flex items-center justify-center gap-3 transition-all shadow-lg shadow-emerald-900/20">
                    <i class="fab fa-whatsapp text-xl"></i> Chat WhatsApp
                </a>
            </div>
            <div class="text-gray-800 text-[8px] md:text-[10px] tracking-[0.4em] md:tracking-[0.6em] font-bold uppercase border-t border-white/5 pt-10">
                &copy; 2026 09IF IMMORTAL FIGHTERS • KINGDOM 3909
            </div>
        </div>
    </footer>

    <script>
        const spreadsheetId = '1utgzEcft4ovmmphPhVGLup0HwNHJwEikIFkYTcFZZus';
        const memberGid = '0';
        const announcementGid = '1549785639';

        // Navigation Toggle Logic
        const menuToggle = document.getElementById('menu-toggle');
        const mobileMenu = document.getElementById('mobile-menu');
        
        function toggleMenu() {
            mobileMenu.classList.toggle('active');
            const icon = menuToggle.querySelector('i');
            if (mobileMenu.classList.contains('active')) {
                icon.classList.replace('fa-bars', 'fa-times');
                document.body.style.overflow = 'hidden';
            } else {
                icon.classList.replace('fa-times', 'fa-bars');
                document.body.style.overflow = '';
            }
        }

        menuToggle.addEventListener('click', toggleMenu);

        async function fetchData(gid) {
            try {
                const url = `https://docs.google.com/spreadsheets/d/${spreadsheetId}/gviz/tq?tqx=out:json&gid=${gid}`;
                const response = await fetch(url);
                const text = await response.text();
                return JSON.parse(text.substring(47, text.length - 2));
            } catch (error) {
                console.error("Gagal memuat GID:", gid, error);
                return null;
            }
        }

        async function loadAnnouncements() {
            const loader = document.getElementById('ann-loader');
            const container = document.getElementById('ann-container');
            const emptyMsg = document.getElementById('ann-empty');
            
            try {
                const data = await fetchData(announcementGid);
                if (!data || !data.table || !data.table.rows) throw new Error("Format error");

                const rows = data.table.rows;
                container.innerHTML = '';
                let count = 0;

                [...rows].reverse().forEach(row => {
                    if (!row.c) return;
                    const date = row.c[0] ? (row.c[0].f || row.c[0].v) : '';
                    const message = row.c[1] ? row.c[1].v : '';

                    if (message && message.toString().trim() !== "") {
                        count++;
                        const div = document.createElement('div');
                        div.className = 'announcement-card p-5 md:p-6 glass-panel flex flex-col sm:flex-row sm:items-start gap-4';
                        div.innerHTML = `
                            <div class="sm:min-w-[120px]">
                                <span class="text-[9px] font-bold text-red-500 uppercase tracking-widest block mb-1">Update Log</span>
                                <span class="text-xs md:text-sm font-black text-white">${date}</span>
                            </div>
                            <div class="flex-1">
                                <p class="text-gray-300 text-sm md:text-base leading-relaxed">${message}</p>
                            </div>
                        `;
                        container.appendChild(div);
                    }
                });

                loader.classList.add('hidden');
                if (count > 0) {
                    container.classList.remove('hidden');
                    emptyMsg.classList.add('hidden');
                } else {
                    emptyMsg.classList.remove('hidden');
                }
            } catch (e) {
                loader.innerHTML = '<span class="text-red-950 text-[10px] tracking-widest">ERROR: GAGAL MENGHUBUNGKAN KE SERVER</span>';
            }
        }

        async function loadMembers() {
            const loader = document.getElementById('member-loader');
            const container = document.getElementById('member-table-container');
            
            try {
                const data = await fetchData(memberGid);
                if (!data) return;

                const rows = data.table.rows;
                const list = document.getElementById('member-list');
                
                list.innerHTML = '';
                rows.forEach((row, index) => {
                    if (!row.c || !row.c[0]) return;

                    const name = row.c[0] ? row.c[0].v : '???';
                    const jabatan = row.c[1] ? row.c[1].v : '-';
                    const status = row.c[3] ? row.c[3].v : 'Active';

                    const tr = document.createElement('tr');
                    tr.className = 'border-b border-white/5';
                    tr.innerHTML = `
                        <td class="px-4 md:px-6 py-4 font-black text-amber-500/30 text-center">${index + 1}</td>
                        <td class="px-4 md:px-6 py-4 font-bold text-white text-[11px] md:text-sm tracking-wide uppercase">${name}</td>
                        <td class="px-4 md:px-6 py-4 text-center text-amber-400 font-semibold italic uppercase text-[9px] md:text-[10px]">${jabatan}</td>
                        <td class="px-4 md:px-6 py-4 text-center">
                            <span class="px-2 py-1 bg-green-900/20 text-green-500 text-[8px] md:text-[10px] rounded border border-green-500/20 font-bold uppercase">
                                ${status}
                            </span>
                        </td>
                    `;
                    list.appendChild(tr);
                });

                loader.classList.add('hidden');
                container.classList.remove('hidden');
            } catch (e) { console.error(e); }
        }

        window.onload = () => {
            loadAnnouncements();
            loadMembers();
        };
    </script>
</body>
</html>
